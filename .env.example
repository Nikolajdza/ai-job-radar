# Local PostgreSQL via Docker Compose
DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar

# Auth (Better Auth) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Optional social login — buttons only appear when both values are set.
# GitHub: https://github.com/settings/developers → OAuth App
#   callback: <BETTER_AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials → OAuth client (Web)
#   redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI — mock needs no API key (default)
AI_PROVIDER=mock

# Optional: Groq free-tier LLM (https://console.groq.com)
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: OpenAI (metered)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Shared secret for n8n → app webhook (/api/webhooks/jobs)
# Must match the x-webhook-secret header in the n8n workflow.
N8N_WEBHOOK_SECRET=dev-n8n-secret-change-me
# Optional: analyse n8n-ingested jobs against this account's profile
# INGEST_USER_EMAIL=you@example.com

# Optional: protect Vercel Cron GET /api/jobs/sync/remotive
# CRON_SECRET=long-random-string
